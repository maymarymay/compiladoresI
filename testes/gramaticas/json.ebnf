(* JSON: objetos, vetores, strings, numeros e as constantes true, false e null *)
TOKENS
  STRING = /"([^"\\\n]|\\.)*"/ ;
  NUMBER = /-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/ ;
  SKIP   = /[ \t\r\n]+/ ;

RULES
  json    = valor ;
  valor   = objeto | vetor | STRING | NUMBER | "true" | "false" | "null" ;
  objeto  = "{" [ membro { "," membro } ] "}" ;
  membro  = STRING ":" valor ;
  vetor   = "[" [ valor { "," valor } ] "]" ;
